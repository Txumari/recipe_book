{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Txumari/recipe_book/scripts/review/findings.schema.json",
  "title": "Agent review findings",
  "description": "Contract every reviewer and the verifier must output, whatever the engine. See openspec change add-agent-code-review, design Decision 4.",
  "type": "object",
  "additionalProperties": false,
  "required": ["reviewer", "findings"],
  "properties": {
    "reviewer": { "type": "string", "enum": ["architecture", "tests", "spec", "verify"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "line", "rule", "severity", "confidence", "title", "message"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "rule": { "type": "string", "pattern": "^R[0-9]+$" },
          "severity": { "type": "string", "enum": ["blocker", "major", "minor", "nit"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
